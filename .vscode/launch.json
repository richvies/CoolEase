{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32: debug",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "svdFile": "tools/openocd/STM32L052.svd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32l0.cfg"
      ],
      "preLaunchTask": "mise: build",
      "executable": "${input:arm-binary}",
      "showDevDebugOutput": "vscode",
      "device": "STM32L0xx",
      "runToEntryPoint": "main"
    },
    {
      "name": "Python: Debug file",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "CMake: Configure debug",
      "type": "cmake",
      "request": "launch",
      "cmakeDebugType": "configure",
      "clean": true,
      "configureAll": false,
      "scriptPath": "${workspaceFolder}/CMakeLists.txt"
    }
  ],
  "inputs": [
    {
      "id": "arm-binary",
      "type": "pickString",
      "description": "Hub or Sensor",
      "options": [
        {
          "label": "Hub",
          "value": "build/debug/hub/freestanding/hub_freestanding_Debug.elf"
        },
        {
          "label": "Hub Bootloader",
          "value": "build/debug/hub/bootloader/hub_bootloader_Debug.elf"
        },
        {
          "label": "Sensor",
          "value": "build/debug/sensor/freestanding/sensor_freestanding_Debug.elf"
        }
      ]
    }
  ]
}